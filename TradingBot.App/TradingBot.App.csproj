<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>TradingBot.App</RootNamespace>
    <AssemblyName>TradingBot.App</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TradingBot.FXCM\TradingBot.FXCM.csproj" />
  </ItemGroup>

  <!--
    Replaces the old <PostBuildEvent> xcopy command, which relied on $(TargetDir) being
    expanded by cmd.exe at PostBuildEvent time - that stopped working after converting this
    project to SDK-style. The MSBuild Copy task below achieves the same "copy every native
    ForexConnect DLL, including subfolders, into the build output" result reliably.
  -->
  <Target Name="CopyForexConnectNativeDlls" AfterTargets="Build">
    <ItemGroup>
      <ForexConnectNativeFiles Include="C:\Program Files\Candleworks\ForexConnectAPIx64\bin\**\*.dll" />
    </ItemGroup>
    <Copy
      SourceFiles="@(ForexConnectNativeFiles)"
      DestinationFolder="$(TargetDir)%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
